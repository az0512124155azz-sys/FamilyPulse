rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isFamilyMember(familyId) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
    }

    match /pairCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /families/{familyId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isFamilyMember(familyId);

      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        allow create: if signedIn() && (
          request.auth.uid == uid ||
          (
            isFamilyMember(familyId) &&
            request.resource.data.role == 'child' &&
            get(/databases/$(database)/documents/pairCodes/$(request.resource.data.inviteCode)).data.uid == uid &&
            get(/databases/$(database)/documents/pairCodes/$(request.resource.data.inviteCode)).data.type == 'child'
          ) ||
          (
            request.auth.uid == uid &&
            request.resource.data.role == 'parent' &&
            get(/databases/$(database)/documents/pairCodes/$(request.resource.data.inviteCode)).data.familyId == familyId &&
            get(/databases/$(database)/documents/pairCodes/$(request.resource.data.inviteCode)).data.type == 'parent'
          )
        );
      }
    }

    match /locationRequests/{childUid} {
      allow read: if signedIn() && request.auth.uid == childUid;
      allow create, update: if signedIn();
    }

    match /locations/{childUid} {
      allow write: if signedIn() && request.auth.uid == childUid;
      allow read: if signedIn();
    }
  }
}
